# Public site URL (no trailing slash). Change when the domain is ready.
SITE_URL=https://example.com
DATABASE_URL=file:./data/rig.db
UPLOAD_DIR=./uploads

# First admin user (created by `npm run db:setup` if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=مدیر سایت

# Secret for ALTCHA challenges and session signing (32+ random chars)
APP_SECRET=replace-with-a-long-random-string

# Outgoing mail (Brevo free SMTP relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=گروه صنعتی رضایی
MAIL_FROM=info@example.com

# Incoming mail (Stalwart IMAP on the same server)
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_USER=info@example.com
IMAP_PASS=
IMAP_TLS_INSECURE=true
INDEXNOW_KEY=
