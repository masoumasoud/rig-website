# Caddy sits behind ArvanCloud. Replace example.com with the real domain.
# HTTPS: Caddy gets a Let's Encrypt certificate for the origin; in Arvan set SSL mode to "Full (strict)".
{
	email admin@example.com
	servers {
		# Trust Arvan's edge so {client_ip} is the visitor (AR-Real-IP / X-Forwarded-For).
		# IMPORTANT: paste the current ranges from https://www.arvancloud.ir/fa/ips.txt
		# (space-separated) in place of ARVAN_RANGES_HERE.
		trusted_proxies static ARVAN_RANGES_HERE
		client_ip_headers AR-Real-IP X-Forwarded-For
	}
}

www.example.com {
	redir https://example.com{uri} permanent
}

example.com {
	encode zstd gzip

	# Public images straight from disk (immutable; Arvan caches them at the edge).
	handle_path /media/* {
		root * /srv/rig/app/uploads/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Hashed build assets: cache forever.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Real-IP {client_ip}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Webmail/admin of the mail server (optional, keep the subdomain DNS-only in Arvan).
mail.example.com {
	reverse_proxy 127.0.0.1:8080
}
